<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SingInActivity"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="30sp"
            android:padding="10sp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome\nPlease sign in here !"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/color_app"
                android:layout_marginTop="20sp"/>

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100sp"
                android:src="@drawable/logo"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/shape"
            android:padding="15sp"
            android:layout_marginHorizontal="20sp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textStyle="bold"
                android:textColor="@color/color_app"
                android:textSize="18sp"
                android:layout_margin="10sp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25sp"
                android:hint="exemple@gmail.com"
                android:textSize="14sp"
                android:drawableEnd="@drawable/ic_email"
                android:drawableTint="@color/color_app"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textStyle="bold"
                android:textColor="@color/color_app"
                android:textSize="18sp"
                android:layout_margin="10sp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="25sp"
                android:hint="********"
                android:textSize="14sp"
                android:drawableEnd="@drawable/ic_password"
                android:drawableTint="@color/color_app"
                />

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10sp"
                android:layout_marginStart="15sp"
                android:text="Remember me !"
                android:textSize="14sp"
                android:textColor="@color/color_app"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_pass"
                android:layout_gravity="end"
                android:layout_marginEnd="15sp"
                android:layout_marginTop="10sp"
                android:textStyle="bold"
                android:textColor="@color/color_app"
                android:textSize="14sp"/>

            <Button
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="12sp"
                android:backgroundTint="@color/color_app"
                android:text="SIGN IN"
                app:cornerRadius="20sp"/>

            <TextView
                android:id="@+id/go_to_sign_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/go_to_sign_up"
                android:layout_gravity="center"
                android:textSize="15sp"
                android:textColor="@color/color_app"
                android:textStyle="bold"
                android:layout_marginBottom="10sp"/>


        </LinearLayout>

    </LinearLayout>

</ScrollView>